{
  "$schema": "https://developer.microsoft.com/json-schemas/sharepoint/list-schema.json",
  "displayName": "AuditLog",
  "description": "Compliance audit logs for student lifecycle account reactivations and holds status changes.",
  "columns": [
    {
      "name": "Title",
      "type": "Text",
      "required": true,
      "displayName": "Transaction GUID"
    },
    {
      "name": "StudentID",
      "type": "Text",
      "required": true,
      "displayName": "Student ID",
      "indexed": true
    },
    {
      "name": "RequestedBy",
      "type": "Text",
      "required": true,
      "displayName": "Requested By"
    },
    {
      "name": "ApprovedBy",
      "type": "Text",
      "required": false,
      "displayName": "Approved By"
    },
    {
      "name": "Action",
      "type": "Choice",
      "required": true,
      "displayName": "Action Taken",
      "choices": [
        "Reactivate",
        "Deny",
        "Escalate",
        "TemporaryAccess"
      ]
    },
    {
      "name": "PolicyCitation",
      "type": "Text",
      "required": true,
      "displayName": "Policy Citation"
    },
    {
      "name": "ReasoningTrace",
      "type": "Note",
      "required": true,
      "displayName": "Reasoning Justification"
    },
    {
      "name": "Timestamp",
      "type": "DateTime",
      "required": true,
      "displayName": "Timestamp (UTC)"
    },
    {
      "name": "ExecutionStatus",
      "type": "Choice",
      "required": true,
      "displayName": "Execution Status",
      "choices": [
        "Pending",
        "Approved",
        "Denied",
        "Executed",
        "Failed"
      ]
    },
    {
      "name": "ReceiptNumber",
      "type": "Text",
      "required": false,
      "displayName": "Receipt Number"
    }
  ]
}
