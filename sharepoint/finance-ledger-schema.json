{
  "$schema": "https://developer.microsoft.com/json-schemas/sharepoint/list-schema.json",
  "displayName": "FinanceLedger",
  "description": "Records student tuition fees due, paid amounts, and payment clearance status at RIT.",
  "columns": [
    {
      "name": "Title",
      "type": "Text",
      "required": true,
      "displayName": "Transaction Reference ID"
    },
    {
      "name": "StudentID",
      "type": "Text",
      "required": true,
      "displayName": "Student ID",
      "indexed": true
    },
    {
      "name": "StudentEmail",
      "type": "Text",
      "required": true,
      "displayName": "Student Email"
    },
    {
      "name": "ReceiptNumber",
      "type": "Text",
      "required": true,
      "displayName": "Receipt Number",
      "indexed": true
    },
    {
      "name": "AmountDue",
      "type": "Currency",
      "required": true,
      "displayName": "Amount Due"
    },
    {
      "name": "AmountPaid",
      "type": "Currency",
      "required": true,
      "displayName": "Amount Paid"
    },
    {
      "name": "PaymentDate",
      "type": "DateTime",
      "required": true,
      "displayName": "Payment Date"
    },
    {
      "name": "PaymentMethod",
      "type": "Choice",
      "required": true,
      "displayName": "Payment Method",
      "choices": [
        "Bank Transfer",
        "Credit Card",
        "Financial Aid",
        "Scholarship",
        "Emergency Voucher"
      ]
    },
    {
      "name": "VerificationStatus",
      "type": "Choice",
      "required": true,
      "displayName": "Verification Status",
      "choices": [
        "Pending",
        "Verified",
        "Rejected"
      ]
    },
    {
      "name": "Notes",
      "type": "Note",
      "required": false,
      "displayName": "Accounting Notes"
    }
  ]
}
