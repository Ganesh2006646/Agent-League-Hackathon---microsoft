# ╔══════════════════════════════════════════════════════════════════════╗
# ║  SUTRADHARA — Environment Configuration Template                    ║
# ║  Copy this file to .env and fill in your credentials               ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ─── 1. Azure AI Foundry (Model-as-a-Service) ────────────────────────
# Base resource endpoint from Azure AI Foundry (just the resource URL, no path)
AZURE_AI_MODEL_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_AI_MODEL_KEY=<your-api-key>
# The deployment name you created in Azure AI Foundry (e.g. gpt-4o-mini)
AZURE_AI_DEPLOYMENT_NAME=gpt-4o-mini

# (Optional) Azure AI Search / Foundry IQ Grounding Engine
# If configured, the Policy agent retrieves grounding documents dynamically from Azure AI Search
AZURE_AI_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_AI_SEARCH_KEY=<your-search-api-key>
AZURE_AI_SEARCH_INDEX=rit-policies-index

# ─── 2. MongoDB Atlas ────────────────────────────────────────────────
# Connection string from MongoDB Atlas
# Go to: cloud.mongodb.com → Cluster → Connect → Drivers → copy URI
# Replace <username>, <password>, <cluster> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ─── 3. SMTP Email (for sending real reactivation emails) ────────────
# Option A: Outlook / Office 365 — Enable 2FA → Security → Create App Password
# Option B: Gmail — Enable 2FA → Security → Create App Password
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=<your-outlook-email@outlook.com>
SMTP_PASS=<your-app-password>
SMTP_FROM="Sutradhara Portal" <your-outlook-email@outlook.com>

# ─── 4. Microsoft Teams Bot (Optional — only if using Teams channel) ─
# Go to: Azure Portal → Bot Channels Registration → App ID & Secret
CLIENT_ID=<azure-bot-app-id>
CLIENT_SECRET=<azure-bot-app-secret>
TENANT_ID=<azure-tenant-id>

# ─── 5. Server ────────────────────────────────────────────────────────
PORT=3000
